# Fonte unica dei pin di toolchain e strumenti.
#
# Questi valori sono replicati come letterali in Dockerfile.dev,
# fuzz/Dockerfile, .github/workflows/ci.yml e negli script di fuzzing: un
# Dockerfile non puo' leggere un file al di fuori del contesto di build senza
# `--build-arg`, e una CI che dipendesse da un `source` renderebbe i pin
# invisibili a chi legge il workflow. La duplicazione e' quindi voluta, e
# `scripts/check_toolchain_pins.py` la rende sicura: verifica che ogni
# consumatore dichiari il pin e che nessuno ne dichiari uno diverso.
#
# Il file e' `source`-abile da bash e leggibile da Python con un parser di due
# righe: niente espansioni, niente commenti a fine riga.

# Toolchain di progetto, la stessa di rust-toolchain.toml. Resta il default
# ovunque: nightly e' installato accanto, non al posto suo.
PLENORA_RUST_STABLE=1.92.0

# Nightly datato, non il canale mobile. Serve solo a -Zsanitizer=address, che
# non esiste su stable, e a nient'altro: due revisioni della stessa data
# costruiscono lo stesso binario strumentato.
PLENORA_RUST_NIGHTLY=nightly-2026-07-21

# Versione esatta: un cargo-fuzz mobile cambierebbe i flag passati a libFuzzer
# fra due esecuzioni della stessa revisione.
PLENORA_CARGO_FUZZ_VERSION=0.13.2

# Idem per la copertura: la percentuale che il gate confronta con la soglia
# dipende da come lo strumento aggrega le regioni, quindi la versione fa parte
# della misura.
PLENORA_CARGO_LLVM_COV_VERSION=0.9.0
