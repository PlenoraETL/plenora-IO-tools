{
  "manifest_version": 1,
  "component": "plenora-IO-tools",
  "protocol_version": 1,
  "status": "frozen_for_1_0",
  "compatibility_scope": "cli_json_only",
  "rust_api": {
    "status": "internal_unstable",
    "semver_guarantee": false,
    "crates_publish": false,
    "reason": "R15.4.1 prevede l'estrazione dei tipi di confine da plenora-io-model; una garanzia pubblica 1.x renderebbe quell'estrazione una rottura."
  },
  "envelopes": {
    "error": {
      "contract": "plenora-io-error-v1",
      "required_top_level": [
        "status",
        "protocol_version",
        "contract",
        "error"
      ],
      "required_error_fields": [
        "category",
        "phase",
        "remote_effect",
        "retry",
        "code",
        "message"
      ],
      "optional_error_fields": [
        "row_diagnostics"
      ],
      "row_diagnostics_semantics": {
        "contract": "plenora-row-diagnostics-v1",
        "present_when": "read_row_scoped_rejections_are_observed_or_write_row_scoped_rejections_are_observed_after_exact_input_total_declaration",
        "missing_write_input_total": "contract_precondition_error_without_row_diagnostics",
        "absent_for_other_errors": true
      },
      "emitted_error_codes": [
        "CANCELLED",
        "INVALID_ROW_DIAGNOSTICS"
      ],
      "exit_codes": {
        "data_mapping": 2,
        "cancelled_by_caller": 130
      }
    },
    "catalog": {
      "contract": "plenora-io-catalog-v1",
      "required_top_level": [
        "status",
        "protocol_version",
        "contract",
        "determinism",
        "drivers"
      ],
      "optional_driver_fields": [
        "available",
        "hostile_input_hardened",
        "required_feature"
      ],
      "current_producer": {
        "required_driver_fields": [
          "available",
          "hostile_input_hardened",
          "required_feature"
        ]
      },
      "driver_field_semantics": {
        "available": {
          "type": "boolean",
          "true_when": "runtime_probe_satisfies_descriptor"
        },
        "required_feature": {
          "type": [
            "string",
            "null"
          ],
          "filegdb": "gdal-backend",
          "other_drivers": null
        },
        "hostile_input_hardened": {
          "type": "boolean",
          "true_when": "every_geometry_text_the_driver_parses_is_bounded_during_the_parse",
          "false_means": "not_declared_not_unsafe",
          "nota": "true dice che i tetti del bordo -- byte, componenti, profondita' -- si applicano mentre il testo viene consumato, non dopo che l'albero e' stato costruito. false non dice «insicuro»: dice che questa garanzia non e' dichiarata, e un driver binario ne ha altre che questo booleano non riassume.",
          "verificata_da": "scripts/check_capability_input_ostile.py"
        }
      }
    },
    "inspect": {
      "contract": "plenora-io-inspect-v1",
      "required_top_level": [
        "status",
        "protocol_version",
        "contract",
        "format",
        "fidelity",
        "layers"
      ]
    },
    "layers": {
      "contract": "plenora-io-layers-v1",
      "required_top_level": [
        "status",
        "protocol_version",
        "contract",
        "format",
        "fidelity",
        "layers"
      ]
    },
    "read": {
      "contract": "plenora-io-read-v1",
      "required_top_level": [
        "status",
        "protocol_version",
        "contract",
        "format",
        "fidelity",
        "layer",
        "rows_read",
        "batches",
        "truncated"
      ]
    },
    "convert": {
      "contract": "plenora-io-convert-v1",
      "required_top_level": [
        "status",
        "protocol_version",
        "contract",
        "from",
        "to",
        "layers",
        "total_rows",
        "bytes_written",
        "publish_outcome",
        "read_fidelity",
        "write_fidelity",
        "conversion_fidelity",
        "read_loss",
        "write_loss"
      ],
      "forbidden_legacy_fields": [
        "loss"
      ]
    }
  },
  "compatibility_rules": {
    "remove_or_rename_required_field": "requires_new_protocol_version",
    "change_field_type_or_meaning": "requires_new_protocol_version",
    "add_optional_field": "allowed_with_change_impact_record",
    "extend_closed_enum": "requires_explicit_compatibility_review"
  },
  "change_impact": [
    {
      "field": "drivers[].hostile_input_hardened",
      "kind": "add_optional_field",
      "protocol_version": 1,
      "lotto": "S12",
      "data": "2026-08-25",
      "impatto_sui_consumatori": "nessuna rottura: il campo si aggiunge, non sostituisce e non cambia significato ad altri. Un consumatore che non lo conosce lo ignora; uno che lo legge ottiene un'affermazione in piu'. La regola `add_optional_field` del contratto lo consente proprio a questa condizione, e questo record e' cio' che la regola chiede.",
      "perche_ora": "il lotto S12 ha reso il parsing di WKT e GeoJSON limitato durante il parse. Una garanzia che resta dentro il nostro codice non e' verificabile da chi ci sta intorno: dichiararla nel catalogo e' il modo in cui la catena a tre componenti puo' controllarla senza leggere i nostri sorgenti.",
      "chi_la_dichiara_oggi": [
        "csv",
        "geojson",
        "xlsx"
      ]
    }
  ]
}
