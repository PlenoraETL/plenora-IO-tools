# Normalizza tutto a LF nel repo e in checkout (cross-platform: Rust + bash).
* text=auto eol=lf
*.sh text eol=lf
*.rs text eol=lf

# Semi binari del fuzzer (contenitori reali: SQLite, Parquet, Arrow IPC, ZIP,
# blob geometria GeoPackage). Nessuna euristica di testo, nessuna
# normalizzazione: un solo byte riscritto li rende semi invalidi.
fuzz/seeds/**/*.gpkg binary
fuzz/seeds/**/*.gpkgb binary
fuzz/seeds/**/*.parquet binary
fuzz/seeds/**/*.arrow binary
fuzz/seeds/**/*.xlsx binary
# Il caso del soak dxf_reader del 2026-10-05: byte NUL e 0xFF fra righe DXF.
# L'euristica lo riconoscerebbe gia' come binario; dichiararlo toglie la
# dipendenza da un'euristica, e il seme vale solo byte per byte.
fuzz/seeds/dxf_reader/sectionsettings-senza-progresso.dxf binary
# Il caso del soak dxf_reader del 2026-10-08, stessa natura: 218 byte.
fuzz/seeds/dxf_reader/datatable-conteggio-negativo.dxf binary

# Copie storiche usate dalle regressioni del misuratore: digest sui byte originali.
scripts/fixtures/soak/misuratore-originale.py.txt binary
scripts/fixtures/soak/referto-originale.json binary
